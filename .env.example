# LitBase-AI public example configuration
# Copy to .env or pass with --env-file.

OPENALEX_MAILTO=your_email@example.com
UNPAYWALL_EMAIL=your_email@example.com
CORE_API_KEY=
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
SEMANTIC_SCHOLAR_API_KEY=

LLM_CONNECT_TIMEOUT=15
LLM_READ_TIMEOUT=45
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2

DOWNLOAD_PROXY=
DOWNLOAD_CONNECT_TIMEOUT=15
DOWNLOAD_READ_TIMEOUT=30
DOWNLOAD_REQUEST_DELAY_MIN=0
DOWNLOAD_REQUEST_DELAY_MAX=0.2
SEARCH_SOURCE_WORKERS=4

ENABLE_SCIHUB=false
ENABLE_LIBGEN=false
ENABLE_ARXIV_DOWNLOAD=true
ENABLE_EZPROXY=false
ENABLE_INST_PROXY=false

EZPROXY_TEMPLATE=
EZPROXY_COOKIE_FILE=
INST_PROXY_MODE=http_proxy
INST_PROXY_URL=
INST_PROXY_COOKIE_FILE=
INST_PROXY_SCHOOL=
WEBVPN_URL=https://your-institution-proxy.example.com
WEBVPN_USERNAME=
WEBVPN_PASSWORD=
WEBVPN_AUTO_LOGIN=false
